{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mxd-admin",
  "account_id": "9896a4c0c345223437f41149b497c25e",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "MODE": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mxd-content",
      "database_id": "5a78a3d2-dfbf-4b77-9764-1f94b4998cc4",
      "migrations_dir": "../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mxd-media"
    }
  ]
}
